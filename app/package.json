{
  "name": "@aveo/app",
  "version": "0.1.0",
  "private": true,
  "description": "Aveo Compliance Desk: front-end (F4) que consome o aveo-hook, o SAS e o Token-2022",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "solana:build": "node dev/solana/docker.mjs build",
    "solana:validator": "node dev/solana/docker.mjs validator",
    "solana:logs": "node dev/solana/docker.mjs logs",
    "solana:stop": "node dev/solana/docker.mjs stop",
    "fixtures": "tsx scripts/fixtures.ts",
    "scenario": "tsx scripts/scenario.ts"
  },
  "dependencies": {
    "@aveo/contracts": "workspace:*",
    "@solana-program/compute-budget": "^0.19.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token-2022": "^0.19.0",
    "@solana/kit": "^8.4.0",
    "@solana/react": "^8.4.0",
    "@solana/sysvars": "^8.4.0",
    "@tanstack/react-query": "^5.104.0",
    "@wallet-standard/react": "^1.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "sas-lib": "1.0.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
