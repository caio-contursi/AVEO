# Rede usada pelo Desk: localnet (validador local) ou devnet.
VITE_CLUSTER=localnet

# RPC HTTP. Em localnet, o validador do Docker responde em 127.0.0.1:8899.
VITE_RPC_URL=http://127.0.0.1:8899

# processed | confirmed | finalized
VITE_COMMITMENT=confirmed

# Endereço do aveo-hook. Vazio = o declare_id! do programa (ExAoxPmugpGbYTVB31oDTqkkG12PM6neFq4vhM6LJd33).
VITE_AVEO_PROGRAM_ID=

# Manifest com mints, verificadores e carteiras da demo. Em localnet, gerado por `pnpm fixtures`
# e servido pelo servidor de desenvolvimento em /dev/deployment.json.
VITE_DEPLOYMENT_URL=/dev/deployment.json

# aveo-sas-hook (rota B, lê e envia para a rede configurada) | mpl3643 (rota A: not-integrated até o gate A)
VITE_BACKEND=aveo-sas-hook

# Só localnet + servidor de desenvolvimento: libera as carteiras sintéticas geradas pelos fixtures.
# Nunca habilite em devnet nem em build de produção.
VITE_ENABLE_DEV_WALLETS=false
