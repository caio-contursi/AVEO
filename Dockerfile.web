FROM node:22-bookworm-slim AS build
WORKDIR /src
RUN npm install -g pnpm@10.33.3
COPY . .
RUN pnpm install --frozen-lockfile
ENV VITE_CLUSTER=devnet \
    VITE_RPC_URL=https://aveoprotocol.io/rpc \
    VITE_COMMITMENT=confirmed \
    VITE_AVEO_PROGRAM_ID=28DDiRDHkqaYYYaZvoFDDpwxUfuZcaehjJpiZfKwzuKS \
    VITE_BACKEND=aveo-sas-hook \
    VITE_DEPLOYMENT_URL=/deployment.json \
    VITE_ENABLE_DEV_WALLETS=false
RUN --mount=type=secret,id=aveo_public_manifest,required=true \
    AVEO_PUBLIC_MANIFEST=/run/secrets/aveo_public_manifest pnpm build:public
FROM nginx:stable-alpine
COPY nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/app/dist /usr/share/nginx/html
EXPOSE 80
