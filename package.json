{
  "name": "aveo",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:program": "cargo build-sbf --tools-version v1.53 && anchor idl build -o target/idl/aveo_hook.json",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:receipts": "pnpm --filter @aveo/app test:receipts",
    "verify": "pnpm typecheck && pnpm --filter @aveo/app typecheck:tests && pnpm --filter @aveo/app lint && pnpm test && pnpm --filter @aveo/app build",
    "fixtures": "pnpm --filter @aveo/app fixtures",
    "scenario": "pnpm --filter @aveo/app scenario",
    "scan:once": "pnpm --filter @aveo/app scan:once",
    "demo:check": "pnpm --filter @aveo/app demo:check",
    "demo:report": "pnpm --filter @aveo/app demo:report",
    "demo:faults": "pnpm --filter @aveo/app demo:faults",
    "demo:http-faults": "pnpm --filter @aveo/app demo:http-faults",
    "demo:health": "pnpm --filter @aveo/app demo:health",
    "build:public": "pnpm --filter @aveo/app build:public",
    "manifest:public": "pnpm --filter @aveo/app manifest:public",
    "devnet:preflight": "pnpm --filter @aveo/app devnet:preflight",
    "local:recovery": "pnpm --filter @aveo/app local:recovery",
    "local:cycle": "pnpm --filter @aveo/app local:cycle",
    "local:recovery:resume": "pnpm --filter @aveo/app local:recovery:resume",
    "dev": "pnpm --filter @aveo/app dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
